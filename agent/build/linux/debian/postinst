#!/bin/sh
set -e

# Enable (but don't start — no logged-in session yet at package-install
# time) the user-level systemd unit for every human user on next login.
mkdir -p /etc/skel/.config/systemd/user/graphical-session.target.wants
ln -sf /usr/lib/systemd/user/tracker-agent.service \
  /etc/skel/.config/systemd/user/graphical-session.target.wants/tracker-agent.service

exit 0
