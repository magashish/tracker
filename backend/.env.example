NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgres://tracker:tracker_dev_password@localhost:5432/tracker
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-secret
STORAGE_SIGNING_SECRET=change-me-to-a-different-random-32-plus-character-secret

# Screenshots are stored on this server's local disk, not S3.
SCREENSHOT_STORAGE_DIR=./data/screenshots
SCREENSHOT_RETENTION_DAYS=7
# Must be the URL agents/dashboard can reach this API at (used to build upload/view links).
PUBLIC_API_URL=http://localhost:3000

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

LOG_LEVEL=info

# Used only by `npm run seed:admin` to bootstrap the first dashboard login.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Owner
